#!/usr/bin/env bash
# The authoritative commit gate (Claude Code hooks are a convenience on top).
# Enable once per clone: scripts/install-git-hooks.sh
# Written for bash 3.2 too, which is what macOS ships as /bin/bash.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

staged=()
python_files=()
# -z keeps non-ASCII names ("Договор.txt") intact; without it git C-quotes them.
while IFS= read -r -d '' file; do
    staged+=("$file")
    case "$file" in
        .claude/skills/*) ;;  # third-party skill files, excluded from project lint
        *.py) python_files+=("$file") ;;
    esac
done < <(git diff --cached --name-only -z --diff-filter=ACMR)

if [ "${#staged[@]}" -eq 0 ]; then
    exit 0
fi

run() { uv run --quiet --frozen "$@"; }
failed=0

if [ "${#python_files[@]}" -gt 0 ]; then
    run ruff format --check "${python_files[@]}" || failed=1
    run ruff check "${python_files[@]}" || failed=1
fi
run python -m tools.check_no_egress || failed=1
run python -m tools.scan_pii --staged || failed=1
run detect-secrets-hook --baseline .secrets.baseline "${staged[@]}" || failed=1

if [ "$failed" -ne 0 ]; then
    echo "pre-commit: blocked. Fix the findings above, then commit again." >&2
fi
exit "$failed"
